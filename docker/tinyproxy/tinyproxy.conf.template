# tinyproxy config for the docker-compose sidecar (see docker-compose.yml).
#
# Why this exists: some trackers (1337x) ban an IPv4 address while leaving
# IPv6 clean. Tunnelling that provider's traffic through here sends it out
# over the host's IPv6 instead. CONNECT only pipes bytes, so TLS stays
# end-to-end between the browser and the tracker - the browser's TLS
# fingerprint is unchanged, only the egress address differs. See
# NOTES.md section 4 for the full diagnosis and reasoning.
#
# Unlike tools/tinyproxy.conf (which Allow-lists a whole /12 for a
# macOS+Colima host setup), this only needs to trust one container on one
# dedicated compose network - keep the Allow list scoped to exactly that
# subnet, not broadened to "the whole Docker range" on a shared host.

Port 8888
Listen 0.0.0.0
Timeout 600

# Scoped to the docker-compose.yml network subnet by default, substituted
# from ALLOWED_SUBNET at container start - see entrypoint.sh. Change the
# subnet via that env var, not by editing this file.
Allow 127.0.0.1
Allow ::1
Allow ${ALLOWED_SUBNET}

# HTTPS tunnelling only - trackers are https-only.
ConnectPort 443
ConnectPort 563

StartServers 2
MaxClients 20
LogLevel Warning
